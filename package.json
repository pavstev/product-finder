{
  "name": "basf-product-finder",
  "private": true,
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.9.0"
  },
  "scripts": {
    "postinstall": "nx run-many -t prisma-generate generate",
    "setup": "pnpm db:up && node scripts/ensure-env.mjs && nx run catalog-import:migrate && nx run catalog-import:seed",
    "dev": "nx run-many -t serve -p api web",
    "dev:api": "nx serve api",
    "dev:web": "nx serve web",
    "check": "prettier --check . && nx run-many -t lint typecheck test build",
    "test": "nx run-many -t test",
    "test:e2e": "nx run-many -t e2e -p api catalog-import",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:products": "nx run catalog-import:import",
    "seed": "nx run catalog-import:seed",
    "db:up": "docker compose up -d --wait db"
  },
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@nestjs/common": "11.2.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.7.1",
    "@ngrx/signals": "22.0.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-nestjs-core": "0.72.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@primeuix/themes": "^3.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "nestjs-pino": "5.3.1",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.4",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@jest/globals": "^30.5.2",
    "@nestjs/testing": "11.2.9",
    "@nx/angular": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/jest": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/playwright": "24.0.6",
    "@nx/webpack": "24.0.6",
    "@playwright/test": "1.65.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "angular-eslint": "22.6.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "jsdom": "^30.0.0",
    "nx": "24.0.6",
    "pino-pretty": "13.2.0",
    "prettier": "3.10.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.72.2",
    "webpack": "5.106.2",
    "webpack-cli": "7.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "prisma"
    ]
  }
}
