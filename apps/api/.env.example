# Local development (docker compose up db). Not a secret: local-only credentials.
DATABASE_URL=postgresql://product_finder:product_finder@localhost:5432/product_finder
# Used by `pnpm test:e2e`. The test database is created by docker/postgres/init-test-db.sql.
TEST_DATABASE_URL=postgresql://product_finder:product_finder@localhost:5432/product_finder_test
PORT=3000
# Local only: the seed adds 12 demo reviews.
SEED_DEMO_REVIEWS=true
