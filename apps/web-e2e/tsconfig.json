/* Playwright compiles the specs itself. This config is for the type check only. */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "src/**/*.ts"]
}
