{
  "uid": "product-finder",
  "title": "Product Finder",
  "description": "API requests, search, reviews and the nightly import. Provisioned from docker/otel/product-finder.json.",
  "tags": ["product-finder"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate and p95 by route",
      "description": "Requests per second and the 95th percentile duration of each API route. Health checks are not traced.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* p95$" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{service_name=\"api\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{service_name=\"api\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}} p95"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Share of API responses with a 5xx status.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "custom": { "axisSoftMax": 0.05 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(http_server_request_duration_seconds_count{service_name=\"api\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{service_name=\"api\"}[$__rate_interval]))",
          "legendFormat": "5xx share"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Search duration",
      "description": "p50 and p95 of product_search_duration_seconds, with and without a search text.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, has_query) (rate(product_search_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 has_query={{has_query}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, has_query) (rate(product_search_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 has_query={{has_query}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Import outcome over time",
      "description": "Import runs by outcome. Each run is a short process with its own series, so this shows one bar per run.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (max_over_time(catalog_import_duration_seconds_count[$__interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Catalog age",
      "description": "Time since the last import that succeeded (catalog_last_success_timestamp_seconds). Red after 26 hours: a nightly run was missed. With no success in the last 7 days, or none ever in this metrics store, it shows 7 days (the query window) in red, not No data.",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 93600 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(time() - max(max_over_time(catalog_last_success_timestamp_seconds[7d]))) or vector(604800)",
          "legendFormat": "catalog age",
          "instant": true
        }
      ]
    }
  ]
}
