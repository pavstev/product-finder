{
  "name": "import",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/import/src",
  "projectType": "library",
  "tags": ["scope:import"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^prisma-generate"],
      "inputs": ["default", "^production", { "externalDependencies": ["typescript"] }],
      "options": {
        "commands": ["tsc --noEmit -p tsconfig.lib.json", "tsc --noEmit -p tsconfig.spec.json"],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "inputs": [
        "default",
        "^production",
        "^testing",
        { "dependentTasksOutputFiles": "**/*.ts", "transitive": true },
        "catalogExport"
      ]
    }
  }
}
